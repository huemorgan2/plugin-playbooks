{
 "new-candidate-unique": {
  "description": "New unique candidate -> create job subitem + link",
  "inputs": {
   "item_id": "1001",
   "item_name": "Alice"
  },
  "stubs": {
   "get_cols": {
    "column_values": [
     {
      "id": "phone_mm6jw2sr",
      "text": "0501234567",
      "type": "phone"
     },
     {
      "id": "short_textmnboddep",
      "text": "9001",
      "type": "text"
     },
     {
      "id": "email_mm6r8nmt",
      "text": "new@ex.com",
      "type": "email"
     }
    ]
   },
   "normalize_phone": "0501234567",
   "get_cols_after": {
    "column_values": [
     {
      "id": "phone_mm6jw2sr",
      "text": "0501234567",
      "type": "phone"
     }
    ]
   },
   "get_job": {
    "id": "9001",
    "name": "Backend Engineer"
   },
   "check_new_has_job": false,
   "find_dupes": {
    "dupes": {
     "entries": []
    }
   }
  },
  "expect": {
   "status": "done",
   "steps_ran": [
    "get_cols",
    "find_dupes",
    "pick_other",
    "create_subitem",
    "link_new_to_job"
   ],
   "steps_not_ran": [
    "old_cols",
    "merge_fields",
    "delete_new",
    "send_conflict_email",
    "create_subitem_conflict"
   ],
   "tool_calls": {
    "monday_api_mutate": {
     "count": 3
    }
   }
  }
 },
